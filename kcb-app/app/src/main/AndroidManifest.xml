<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 高德定位 SDK 需要 -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_LOCATION_EXTRA_COMMANDS" />
    <!-- 查寝签到定位 -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- 校园网自动登录：常驻前台服务 + 开机自启 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- 关闭 Auto Backup：数据库/日志文件不应随云备份外泄 -->
    <application
        android:name=".KcbApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:windowSoftInputMode="adjustResize"
        android:theme="@style/Theme.Kcb">
        <meta-data android:name="com.amap.api.v2.apikey" android:value="7700f7b6cfad866a8153b9b76d53d9fa" />
        <!-- 高德定位 SDK 要求的定位服务组件（官方文档必配） -->
        <service android:name="com.amap.api.location.APSService" />
        <!-- 校园网自动登录：短时前台服务（仅认证几秒内存活）+ Wi-Fi 事件回调接收器 -->
        <service
            android:name=".net.NetAuthService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <receiver
            android:name=".net.NetCallbackReceiver"
            android:exported="false" />
        <receiver
            android:name=".net.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 宿舍电费：纯 View 独立 Activity（Compose 内嵌 WebView 在本机不渲染，见 ElecActivity 注释） -->
        <activity
            android:name=".ui.ykt.ElecActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 收银台：同理独立 Activity -->
        <activity
            android:name=".ui.ykt.CashierActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <!-- 查寝签到拍照缓存（TakePicture 写入） -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="li.lyc.lzuapp.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
